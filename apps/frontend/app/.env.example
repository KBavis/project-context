# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Set to "true" only if the backend's Azure endpoint is a multi-vendor gateway
# (i.e. backend AZURE_MULTI_VENDOR_GATEWAY=true). When true, non-OpenAI vendors
# (e.g. Claude) become selectable; otherwise Azure offers OpenAI models only.
VITE_AZURE_MULTI_VENDOR_GATEWAY=false
