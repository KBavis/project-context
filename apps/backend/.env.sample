POSTGRES_DB=contextualized
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourDatabasePassword
SYNC_REL_DB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
ASYNC_REL_DB_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

VECTOR_DB_HOST=chromadb
VECTOR_DB_PORT=8000

ENV=dev

# JIRA_EMAIL=XXX
# JIRA_API_TOKEN=XXX

#EMBEDDING_MODEL_CACHE_SIZE: int = 5

# OLLAMA_MODEL_TOKENIZER: str = "openai/gpt-oss-20b" 
#LLM_EXPECTED_RESPONSE_SIZE=500

# set this value to the percision figured for your Ollama server running 
# OLLAMA_KV_CACHE_TYPE=f16 

# DOCLING_ACCELERATOR_DEVICE=cuda

#GITHUB_SECRET_TOKEN=
#BITBUCKET_USERNAME=
#BITBUCKET_SECRET_TOKEN=
#CONFLUENCE_EMAIL=
#CONFLUENCE_SECRET_TOKEN=
#OPENAI_API_KEY=

# --- Azure-native OpenAI-compatible gateway (LLM + embeddings) ---
#LL_MODEL_PROVIDER=AzureOpenAI
#LL_MODEL=gpt-4o
#LLM_API_BASE=
#LLM_API_VERSION=2024-10-21
#EMBEDDING_PROVIDER=AzureOpenAI
#EMBEDDING_MODEL=text-embedding-3-large
#EMBEDDING_API_BASE=
#EMBEDDING_API_VERSION=2024-10-21
#EMBEDDING_MAX_TOKENS=8191
#EMBEDDING_BATCH_SIZE=100

# --- Ingestion batching (tune for large repositories) ---
#DOCSTORE_INSERT_BATCH_SIZE=512
#BITBUCKET_MAX_CONCURRENT_DOWNLOADS=3

# --- Repo-specific ingestion excludes (company-agnostic defaults live in config.py) ---
# JSON array of extra glob patterns, layered on top of INGESTION_EXCLUDE_PATTERNS, for paths
# that are noise in YOUR repos (test fixtures, seed data, vendored tool exports, etc.).
#INGESTION_EXCLUDE_PATTERNS_EXTRA=["*/static/js/ext/*", "*/test/*/resources/*", "*/_data/*", "*/initialized-data/*", "*.postman_collection.json"]

#LL_MODEL_CHAT_SUMMARY_SYSTEM_PROMPT=

